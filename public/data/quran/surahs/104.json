{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","revelationType":"Meccan","numberOfAyahs":9,"ayahs":[{"number":6180,"numberInSurah":1,"juz":30,"page":601,"hizbQuarter":240,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","translation":"Woe to every scorner and mocker","transliteration":"Wai lul-li kulli hu mazatil-lumaza"},{"number":6181,"numberInSurah":2,"juz":30,"page":601,"hizbQuarter":240,"text":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","translation":"Who collects wealth and [continuously] counts it.","transliteration":"Al-lazi jama'a maalaw wa'addadah"},{"number":6182,"numberInSurah":3,"juz":30,"page":601,"hizbQuarter":240,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","translation":"He thinks that his wealth will make him immortal.","transliteration":"Yahsabu anna maalahu akhladah"},{"number":6183,"numberInSurah":4,"juz":30,"page":601,"hizbQuarter":240,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","translation":"No! He will surely be thrown into the Crusher.","transliteration":"Kalla layum ba zanna fil hutamah"},{"number":6184,"numberInSurah":5,"juz":30,"page":601,"hizbQuarter":240,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","translation":"And what can make you know what is the Crusher?","transliteration":"Wa maa adraaka mal-hutamah"},{"number":6185,"numberInSurah":6,"juz":30,"page":601,"hizbQuarter":240,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","translation":"It is the fire of Allah, [eternally] fueled,","transliteration":"Narul laahil-mooqada"},{"number":6186,"numberInSurah":7,"juz":30,"page":601,"hizbQuarter":240,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","translation":"Which mounts directed at the hearts.","transliteration":"Al latee tat tali'u 'alalafidah"},{"number":6187,"numberInSurah":8,"juz":30,"page":601,"hizbQuarter":240,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","translation":"Indeed, Hellfire will be closed down upon them","transliteration":"Innaha 'alaihim mu'sada"},{"number":6188,"numberInSurah":9,"juz":30,"page":601,"hizbQuarter":240,"text":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","translation":"In extended columns.","transliteration":"Fee 'amadim-mu mad dadah"}]}