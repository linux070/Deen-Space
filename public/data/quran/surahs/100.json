{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6147,"numberInSurah":1,"juz":30,"page":599,"hizbQuarter":239,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","translation":"By the racers, panting,","transliteration":"Wal'aadi yaati dabha"},{"number":6148,"numberInSurah":2,"juz":30,"page":599,"hizbQuarter":239,"text":"فَٱلْمُورِيَٰتِ قَدْحًۭا","translation":"And the producers of sparks [when] striking","transliteration":"Fal moori yaati qadha"},{"number":6149,"numberInSurah":3,"juz":30,"page":599,"hizbQuarter":239,"text":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","translation":"And the chargers at dawn,","transliteration":"Fal mugheeraati subha"},{"number":6150,"numberInSurah":4,"juz":30,"page":599,"hizbQuarter":239,"text":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","translation":"Stirring up thereby [clouds of] dust,","transliteration":"Fa atharna bihee naq'a"},{"number":6151,"numberInSurah":5,"juz":30,"page":599,"hizbQuarter":239,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","translation":"Arriving thereby in the center collectively,","transliteration":"Fawa satna bihee jam'a"},{"number":6152,"numberInSurah":6,"juz":30,"page":599,"hizbQuarter":239,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","translation":"Indeed mankind, to his Lord, is ungrateful.","transliteration":"Innal-insana lirabbihee lakanood"},{"number":6153,"numberInSurah":7,"juz":30,"page":599,"hizbQuarter":239,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","translation":"And indeed, he is to that a witness.","transliteration":"Wa innahu 'alaa zaalika la shaheed"},{"number":6154,"numberInSurah":8,"juz":30,"page":599,"hizbQuarter":239,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","translation":"And indeed he is, in love of wealth, intense.","transliteration":"Wa innahu lihubbil khairi la shadeed"},{"number":6155,"numberInSurah":9,"juz":30,"page":599,"hizbQuarter":240,"text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","translation":"But does he not know that when the contents of the graves are scattered","transliteration":"Afala ya'lamu iza b'uthira ma filquboor"},{"number":6156,"numberInSurah":10,"juz":30,"page":600,"hizbQuarter":240,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","translation":"And that within the breasts is obtained,","transliteration":"Wa hussila maa fis sudoor"},{"number":6157,"numberInSurah":11,"juz":30,"page":600,"hizbQuarter":240,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","translation":"Indeed, their Lord with them, that Day, is [fully] Acquainted.","transliteration":"Inna rabbahum bihim yauma 'izil la khabeer"}]}