{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"numberInSurah":1,"juz":30,"page":591,"hizbQuarter":236,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","translation":"By the sky and the night comer -","transliteration":"Wassamaaa'i wattaariq"},{"number":5933,"numberInSurah":2,"juz":30,"page":591,"hizbQuarter":236,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","translation":"And what can make you know what is the night comer?","transliteration":"Wa maaa adraaka mattaariq"},{"number":5934,"numberInSurah":3,"juz":30,"page":591,"hizbQuarter":236,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","translation":"It is the piercing star -","transliteration":"Annajmus saaqib"},{"number":5935,"numberInSurah":4,"juz":30,"page":591,"hizbQuarter":236,"text":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","translation":"There is no soul but that it has over it a protector.","transliteration":"In kullu nafsil lammaa 'alaihaa haafiz"},{"number":5936,"numberInSurah":5,"juz":30,"page":591,"hizbQuarter":236,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","translation":"So let man observe from what he was created.","transliteration":"Fal yanzuril insaanu mimma khuliq"},{"number":5937,"numberInSurah":6,"juz":30,"page":591,"hizbQuarter":236,"text":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","translation":"He was created from a fluid, ejected,","transliteration":"Khuliqa mim maaa'in daafiq"},{"number":5938,"numberInSurah":7,"juz":30,"page":591,"hizbQuarter":236,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","translation":"Emerging from between the backbone and the ribs.","transliteration":"Yakhruju mim bainissulbi wat taraaa'ib"},{"number":5939,"numberInSurah":8,"juz":30,"page":591,"hizbQuarter":236,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","translation":"Indeed, Allah, to return him [to life], is Able.","transliteration":"Innahoo 'alaa raj'ihee laqaadir"},{"number":5940,"numberInSurah":9,"juz":30,"page":591,"hizbQuarter":236,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","translation":"The Day when secrets will be put on trial,","transliteration":"Yawma tublas saraaa'ir"},{"number":5941,"numberInSurah":10,"juz":30,"page":591,"hizbQuarter":236,"text":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","translation":"Then man will have no power or any helper.","transliteration":"Famaa lahoo min quwwatinw wa laa naasir"},{"number":5942,"numberInSurah":11,"juz":30,"page":591,"hizbQuarter":236,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","translation":"By the sky which returns [rain]","transliteration":"Wassamaaa'i zaatir raj'"},{"number":5943,"numberInSurah":12,"juz":30,"page":591,"hizbQuarter":236,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","translation":"And [by] the earth which cracks open,","transliteration":"Wal ardi zaatis sad'"},{"number":5944,"numberInSurah":13,"juz":30,"page":591,"hizbQuarter":236,"text":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","translation":"Indeed, the Qur'an is a decisive statement,","transliteration":"Innahoo laqawlun fasl"},{"number":5945,"numberInSurah":14,"juz":30,"page":591,"hizbQuarter":236,"text":"وَمَا هُوَ بِٱلْهَزْلِ","translation":"And it is not amusement.","transliteration":"Wa maa huwa bil hazl"},{"number":5946,"numberInSurah":15,"juz":30,"page":591,"hizbQuarter":236,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","translation":"Indeed, they are planning a plan,","transliteration":"Innahum yakeedoona kaidaa"},{"number":5947,"numberInSurah":16,"juz":30,"page":591,"hizbQuarter":236,"text":"وَأَكِيدُ كَيْدًۭا","translation":"But I am planning a plan.","transliteration":"Wa akeedu kaidaa"},{"number":5948,"numberInSurah":17,"juz":30,"page":591,"hizbQuarter":236,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","translation":"So allow time for the disbelievers. Leave them awhile.","transliteration":"Famahhilil kaafireena amhilhum ruwaidaa"}]}