{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"numberInSurah":1,"juz":30,"page":597,"hizbQuarter":239,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","translation":"Recite in the name of your Lord who created -","transliteration":"Iqra bismi rab bikal lazee khalaq"},{"number":6108,"numberInSurah":2,"juz":30,"page":597,"hizbQuarter":239,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","translation":"Created man from a clinging substance.","transliteration":"Khalaqal insaana min 'alaq"},{"number":6109,"numberInSurah":3,"juz":30,"page":597,"hizbQuarter":239,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","translation":"Recite, and your Lord is the most Generous -","transliteration":"Iqra wa rab bukal akram"},{"number":6110,"numberInSurah":4,"juz":30,"page":597,"hizbQuarter":239,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","translation":"Who taught by the pen -","transliteration":"Al lazee 'allama bil qalam"},{"number":6111,"numberInSurah":5,"juz":30,"page":597,"hizbQuarter":239,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","translation":"Taught man that which he knew not.","transliteration":"'Al lamal insaana ma lam y'alam"},{"number":6112,"numberInSurah":6,"juz":30,"page":597,"hizbQuarter":239,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","translation":"No! [But] indeed, man transgresses","transliteration":"Kallaa innal insaana layatghaa"},{"number":6113,"numberInSurah":7,"juz":30,"page":597,"hizbQuarter":239,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","translation":"Because he sees himself self-sufficient.","transliteration":"Ar-ra aahus taghnaa"},{"number":6114,"numberInSurah":8,"juz":30,"page":597,"hizbQuarter":239,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","translation":"Indeed, to your Lord is the return.","transliteration":"Innna ilaa rabbikar ruj'aa"},{"number":6115,"numberInSurah":9,"juz":30,"page":597,"hizbQuarter":239,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","translation":"Have you seen the one who forbids","transliteration":"Ara-aital lazee yanhaa"},{"number":6116,"numberInSurah":10,"juz":30,"page":597,"hizbQuarter":239,"text":"عَبْدًا إِذَا صَلَّىٰٓ","translation":"A servant when he prays?","transliteration":"'Abdan iza sallaa"},{"number":6117,"numberInSurah":11,"juz":30,"page":597,"hizbQuarter":239,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","translation":"Have you seen if he is upon guidance","transliteration":"Ara-aita in kana 'alal hudaa"},{"number":6118,"numberInSurah":12,"juz":30,"page":597,"hizbQuarter":239,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","translation":"Or enjoins righteousness?","transliteration":"Au amara bit taqwaa"},{"number":6119,"numberInSurah":13,"juz":30,"page":597,"hizbQuarter":239,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translation":"Have you seen if he denies and turns away -","transliteration":"Ara-aita in kaz zaba wa ta walla"},{"number":6120,"numberInSurah":14,"juz":30,"page":597,"hizbQuarter":239,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translation":"Does he not know that Allah sees?","transliteration":"Alam y'alam bi-an nal lahaa yaraa"},{"number":6121,"numberInSurah":15,"juz":30,"page":597,"hizbQuarter":239,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","translation":"No! If he does not desist, We will surely drag him by the forelock -","transliteration":"Kalla la illam yantahi la nasfa'am bin nasiyah"},{"number":6122,"numberInSurah":16,"juz":30,"page":597,"hizbQuarter":239,"text":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","translation":"A lying, sinning forelock.","transliteration":"Nasiyatin kazi batin khaatiyah"},{"number":6123,"numberInSurah":17,"juz":30,"page":597,"hizbQuarter":239,"text":"فَلْيَدْعُ نَادِيَهُۥ","translation":"Then let him call his associates;","transliteration":"Fal yad'u naadiyah"},{"number":6124,"numberInSurah":18,"juz":30,"page":597,"hizbQuarter":239,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","translation":"We will call the angels of Hell.","transliteration":"Sanad 'uz zabaaniyah"},{"number":6125,"numberInSurah":19,"juz":30,"page":597,"hizbQuarter":239,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","translation":"No! Do not obey him. But prostrate and draw near [to Allah].","transliteration":"Kalla; la tuti'hu wasjud waqtarib"}]}