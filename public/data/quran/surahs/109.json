{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6208,"numberInSurah":1,"juz":30,"page":603,"hizbQuarter":240,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","translation":"Say, \"O disbelievers,","transliteration":"Qul yaa-ai yuhal kaafiroon"},{"number":6209,"numberInSurah":2,"juz":30,"page":603,"hizbQuarter":240,"text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","translation":"I do not worship what you worship.","transliteration":"Laa a'budu ma t'abudoon"},{"number":6210,"numberInSurah":3,"juz":30,"page":603,"hizbQuarter":240,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","translation":"Nor are you worshippers of what I worship.","transliteration":"Wa laa antum 'aabidoona maa a'bud"},{"number":6211,"numberInSurah":4,"juz":30,"page":603,"hizbQuarter":240,"text":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","translation":"Nor will I be a worshipper of what you worship.","transliteration":"Wa laa ana 'abidum maa 'abattum"},{"number":6212,"numberInSurah":5,"juz":30,"page":603,"hizbQuarter":240,"text":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","translation":"Nor will you be worshippers of what I worship.","transliteration":"Wa laa antum 'aabidoona ma a'bud"},{"number":6213,"numberInSurah":6,"juz":30,"page":603,"hizbQuarter":240,"text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","translation":"For you is your religion, and for me is my religion.\"","transliteration":"Lakum deenukum wa liya deen."}]}