{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"numberInSurah":1,"juz":30,"page":604,"hizbQuarter":240,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","translation":"Say, \"He is Allah, [who is] One,","transliteration":"Qul huwal laahu ahad"},{"number":6223,"numberInSurah":2,"juz":30,"page":604,"hizbQuarter":240,"text":"ٱللَّهُ ٱلصَّمَدُ","translation":"Allah, the Eternal Refuge.","transliteration":"Allah hus-samad"},{"number":6224,"numberInSurah":3,"juz":30,"page":604,"hizbQuarter":240,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","translation":"He neither begets nor is born,","transliteration":"Lam yalid wa lam yoolad"},{"number":6225,"numberInSurah":4,"juz":30,"page":604,"hizbQuarter":240,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","translation":"Nor is there to Him any equivalent.\"","transliteration":"Wa lam yakul-lahu kufuwan ahad"}]}