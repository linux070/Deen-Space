{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"numberInSurah":1,"juz":30,"page":586,"hizbQuarter":234,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","translation":"When the sun is wrapped up [in darkness]","transliteration":"Izash shamsu kuwwirat"},{"number":5802,"numberInSurah":2,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","translation":"And when the stars fall, dispersing,","transliteration":"Wa izan nujoomun kadarat"},{"number":5803,"numberInSurah":3,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","translation":"And when the mountains are removed","transliteration":"Wa izal jibaalu suyyirat"},{"number":5804,"numberInSurah":4,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","translation":"And when full-term she-camels are neglected","transliteration":"Wa izal 'ishaaru 'uttilat"},{"number":5805,"numberInSurah":5,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","translation":"And when the wild beasts are gathered","transliteration":"Wa izal wuhooshu hushirat"},{"number":5806,"numberInSurah":6,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","translation":"And when the seas are filled with flame","transliteration":"Wa izal bihaaru sujjirat"},{"number":5807,"numberInSurah":7,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","translation":"And when the souls are paired","transliteration":"Wa izan nufoosu zuwwijat"},{"number":5808,"numberInSurah":8,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","translation":"And when the girl [who was] buried alive is asked","transliteration":"Wa izal maw'oodatu su'ilat"},{"number":5809,"numberInSurah":9,"juz":30,"page":586,"hizbQuarter":234,"text":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","translation":"For what sin she was killed","transliteration":"Bi ayyi zambin qutilat"},{"number":5810,"numberInSurah":10,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","translation":"And when the pages are made public","transliteration":"Wa izas suhufu nushirat"},{"number":5811,"numberInSurah":11,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","translation":"And when the sky is stripped away","transliteration":"Wa izas samaaa'u kushitat"},{"number":5812,"numberInSurah":12,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","translation":"And when Hellfire is set ablaze","transliteration":"Wa izal jaheemu su'-'irat"},{"number":5813,"numberInSurah":13,"juz":30,"page":586,"hizbQuarter":234,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","translation":"And when Paradise is brought near,","transliteration":"Wa izal jannatu uzlifat"},{"number":5814,"numberInSurah":14,"juz":30,"page":586,"hizbQuarter":234,"text":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","translation":"A soul will [then] know what it has brought [with it].","transliteration":"'Alimat nafsum maaa ahdarat"},{"number":5815,"numberInSurah":15,"juz":30,"page":586,"hizbQuarter":234,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","translation":"So I swear by the retreating stars -","transliteration":"Falaaa uqsimu bil khunnas"},{"number":5816,"numberInSurah":16,"juz":30,"page":586,"hizbQuarter":234,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","translation":"Those that run [their courses] and disappear -","transliteration":"Al jawaaril kunnas"},{"number":5817,"numberInSurah":17,"juz":30,"page":586,"hizbQuarter":234,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","translation":"And by the night as it closes in","transliteration":"Wallaili izaa 'as'as"},{"number":5818,"numberInSurah":18,"juz":30,"page":586,"hizbQuarter":234,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","translation":"And by the dawn when it breathes","transliteration":"Wassubhi izaa tanaffas"},{"number":5819,"numberInSurah":19,"juz":30,"page":586,"hizbQuarter":234,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","translation":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger","transliteration":"Innahoo laqawlu rasoolin kareem"},{"number":5820,"numberInSurah":20,"juz":30,"page":586,"hizbQuarter":234,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","translation":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],","transliteration":"Zee quwwatin 'inda zil 'arshi makeen"},{"number":5821,"numberInSurah":21,"juz":30,"page":586,"hizbQuarter":234,"text":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","translation":"Obeyed there [in the heavens] and trustworthy.","transliteration":"Mutaa'in samma ameen"},{"number":5822,"numberInSurah":22,"juz":30,"page":586,"hizbQuarter":234,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","translation":"And your companion is not [at all] mad.","transliteration":"Wa maa saahibukum bimajnoon"},{"number":5823,"numberInSurah":23,"juz":30,"page":586,"hizbQuarter":234,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","translation":"And he has already seen Gabriel in the clear horizon.","transliteration":"Wa laqad ra aahu bilufuqil mubeen"},{"number":5824,"numberInSurah":24,"juz":30,"page":586,"hizbQuarter":234,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","translation":"And Muhammad is not a withholder of [knowledge of] the unseen.","transliteration":"Wa maa huwa 'alal ghaibi bidaneen"},{"number":5825,"numberInSurah":25,"juz":30,"page":586,"hizbQuarter":234,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","translation":"And the Qur'an is not the word of a devil, expelled [from the heavens].","transliteration":"Wa maa huwa biqawli shaitaanir rajeem"},{"number":5826,"numberInSurah":26,"juz":30,"page":586,"hizbQuarter":234,"text":"فَأَيْنَ تَذْهَبُونَ","translation":"So where are you going?","transliteration":"Fa ayna tazhaboon"},{"number":5827,"numberInSurah":27,"juz":30,"page":586,"hizbQuarter":234,"text":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","translation":"It is not except a reminder to the worlds","transliteration":"In huwa illaa zikrul lil'aalameen"},{"number":5828,"numberInSurah":28,"juz":30,"page":586,"hizbQuarter":234,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","translation":"For whoever wills among you to take a right course.","transliteration":"Liman shaaa'a minkum ai yastaqeem"},{"number":5829,"numberInSurah":29,"juz":30,"page":586,"hizbQuarter":234,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","translation":"And you do not will except that Allah wills - Lord of the worlds.","transliteration":"Wa maa tashaaa'oona illaaa ai yashaaa 'al laahu Rabbul 'Aalameen"}]}