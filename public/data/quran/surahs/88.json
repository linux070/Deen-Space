{"number":88,"name":"سُورَةُ الغَاشِيَةِ","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelationType":"Meccan","numberOfAyahs":26,"ayahs":[{"number":5968,"numberInSurah":1,"juz":30,"page":592,"hizbQuarter":237,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","translation":"Has there reached you the report of the Overwhelming [event]?","transliteration":"Hal ataaka hadeesul ghaashiyah"},{"number":5969,"numberInSurah":2,"juz":30,"page":592,"hizbQuarter":237,"text":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","translation":"[Some] faces, that Day, will be humbled,","transliteration":"Wujoohuny yawma 'izin khaashi'ah"},{"number":5970,"numberInSurah":3,"juz":30,"page":592,"hizbQuarter":237,"text":"عَامِلَةٌۭ نَّاصِبَةٌۭ","translation":"Working [hard] and exhausted.","transliteration":"'Aamilatun naasibah"},{"number":5971,"numberInSurah":4,"juz":30,"page":592,"hizbQuarter":237,"text":"تَصْلَىٰ نَارًا حَامِيَةًۭ","translation":"They will [enter to] burn in an intensely hot Fire.","transliteration":"Taslaa naaran haamiyah"},{"number":5972,"numberInSurah":5,"juz":30,"page":592,"hizbQuarter":237,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","translation":"They will be given drink from a boiling spring.","transliteration":"Tusqaa min 'aynin aaniyah"},{"number":5973,"numberInSurah":6,"juz":30,"page":592,"hizbQuarter":237,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","translation":"For them there will be no food except from a poisonous, thorny plant","transliteration":"Laisa lahum ta'aamun illaa min daree'"},{"number":5974,"numberInSurah":7,"juz":30,"page":592,"hizbQuarter":237,"text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","translation":"Which neither nourishes nor avails against hunger.","transliteration":"Laa yusminu wa laa yughnee min joo'"},{"number":5975,"numberInSurah":8,"juz":30,"page":592,"hizbQuarter":237,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","translation":"[Other] faces, that Day, will show pleasure.","transliteration":"Wujoohuny yawma 'izin naa'imah"},{"number":5976,"numberInSurah":9,"juz":30,"page":592,"hizbQuarter":237,"text":"لِّسَعْيِهَا رَاضِيَةٌۭ","translation":"With their effort [they are] satisfied","transliteration":"Lisa'yihaa raadiyah"},{"number":5977,"numberInSurah":10,"juz":30,"page":592,"hizbQuarter":237,"text":"فِى جَنَّةٍ عَالِيَةٍۢ","translation":"In an elevated garden,","transliteration":"Fee jannatin 'aaliyah"},{"number":5978,"numberInSurah":11,"juz":30,"page":592,"hizbQuarter":237,"text":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","translation":"Wherein they will hear no unsuitable speech.","transliteration":"Laa tasma'u feehaa laaghiyah"},{"number":5979,"numberInSurah":12,"juz":30,"page":592,"hizbQuarter":237,"text":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","translation":"Within it is a flowing spring.","transliteration":"Feehaa 'aynun jaariyah"},{"number":5980,"numberInSurah":13,"juz":30,"page":592,"hizbQuarter":237,"text":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","translation":"Within it are couches raised high","transliteration":"Feehaa sururum marfoo'ah"},{"number":5981,"numberInSurah":14,"juz":30,"page":592,"hizbQuarter":237,"text":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","translation":"And cups put in place","transliteration":"Wa akwaabum mawdoo 'ah"},{"number":5982,"numberInSurah":15,"juz":30,"page":592,"hizbQuarter":237,"text":"وَنَمَارِقُ مَصْفُوفَةٌۭ","translation":"And cushions lined up","transliteration":"Wa namaariqu masfoofah"},{"number":5983,"numberInSurah":16,"juz":30,"page":592,"hizbQuarter":237,"text":"وَزَرَابِىُّ مَبْثُوثَةٌ","translation":"And carpets spread around.","transliteration":"Wa zaraabiyyu mabsoosah"},{"number":5984,"numberInSurah":17,"juz":30,"page":592,"hizbQuarter":237,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","translation":"Then do they not look at the camels - how they are created?","transliteration":"Afalaa yanzuroona ilalibili kaifa khuliqat"},{"number":5985,"numberInSurah":18,"juz":30,"page":592,"hizbQuarter":237,"text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","translation":"And at the sky - how it is raised?","transliteration":"Wa ilas samaaa'i kaifa rufi'at"},{"number":5986,"numberInSurah":19,"juz":30,"page":592,"hizbQuarter":237,"text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","translation":"And at the mountains - how they are erected?","transliteration":"Wa ilal jibaali kaifa nusibat"},{"number":5987,"numberInSurah":20,"juz":30,"page":592,"hizbQuarter":237,"text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","translation":"And at the earth - how it is spread out?","transliteration":"Wa ilal ardi kaifa sutihat"},{"number":5988,"numberInSurah":21,"juz":30,"page":592,"hizbQuarter":237,"text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","translation":"So remind, [O Muhammad]; you are only a reminder.","transliteration":"Fazakkir innama anta Muzakkir"},{"number":5989,"numberInSurah":22,"juz":30,"page":592,"hizbQuarter":237,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","translation":"You are not over them a controller.","transliteration":"Lasta 'alaihim bimusaitir"},{"number":5990,"numberInSurah":23,"juz":30,"page":592,"hizbQuarter":237,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","translation":"However, he who turns away and disbelieves -","transliteration":"Illaa man tawallaa wa kafar"},{"number":5991,"numberInSurah":24,"juz":30,"page":592,"hizbQuarter":237,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","translation":"Then Allah will punish him with the greatest punishment.","transliteration":"Fa yu'azzibuhul laahul 'azaabal akbar"},{"number":5992,"numberInSurah":25,"juz":30,"page":592,"hizbQuarter":237,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","translation":"Indeed, to Us is their return.","transliteration":"Innaa ilainaaa iyaabahum"},{"number":5993,"numberInSurah":26,"juz":30,"page":592,"hizbQuarter":237,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","translation":"Then indeed, upon Us is their account.","transliteration":"Summa inna 'alainaa hisaabahum"}]}