{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"numberInSurah":1,"juz":30,"page":600,"hizbQuarter":240,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","translation":"Competition in [worldly] increase diverts you","transliteration":"Al haaku mut takathur"},{"number":6170,"numberInSurah":2,"juz":30,"page":600,"hizbQuarter":240,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","translation":"Until you visit the graveyards.","transliteration":"Hatta zurtumul-maqaabir"},{"number":6171,"numberInSurah":3,"juz":30,"page":600,"hizbQuarter":240,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","translation":"No! You are going to know.","transliteration":"Kalla sawfa ta'lamoon"},{"number":6172,"numberInSurah":4,"juz":30,"page":600,"hizbQuarter":240,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","translation":"Then no! You are going to know.","transliteration":"Thumma kalla sawfa ta'lamoon"},{"number":6173,"numberInSurah":5,"juz":30,"page":600,"hizbQuarter":240,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","translation":"No! If you only knew with knowledge of certainty...","transliteration":"Kalla law ta'lamoona 'ilmal yaqeen"},{"number":6174,"numberInSurah":6,"juz":30,"page":600,"hizbQuarter":240,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","translation":"You will surely see the Hellfire.","transliteration":"Latara-wun nal jaheem"},{"number":6175,"numberInSurah":7,"juz":30,"page":600,"hizbQuarter":240,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","translation":"Then you will surely see it with the eye of certainty.","transliteration":"Thumma latara wunnaha 'ainal yaqeen"},{"number":6176,"numberInSurah":8,"juz":30,"page":600,"hizbQuarter":240,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","translation":"Then you will surely be asked that Day about pleasure.","transliteration":"Thumma latus alunna yauma-izin 'anin na'eem"}]}