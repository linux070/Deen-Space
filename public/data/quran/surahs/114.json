{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","englishNameTranslation":"Mankind","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6231,"numberInSurah":1,"juz":30,"page":604,"hizbQuarter":240,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"Say, \"I seek refuge in the Lord of mankind,","transliteration":"Qul a'uzu birabbin naas"},{"number":6232,"numberInSurah":2,"juz":30,"page":604,"hizbQuarter":240,"text":"مَلِكِ ٱلنَّاسِ","translation":"The Sovereign of mankind.","transliteration":"Malikin naas"},{"number":6233,"numberInSurah":3,"juz":30,"page":604,"hizbQuarter":240,"text":"إِلَٰهِ ٱلنَّاسِ","translation":"The God of mankind,","transliteration":"Ilaahin naas"},{"number":6234,"numberInSurah":4,"juz":30,"page":604,"hizbQuarter":240,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","translation":"From the evil of the retreating whisperer -","transliteration":"Min sharril was waasil khannaas"},{"number":6235,"numberInSurah":5,"juz":30,"page":604,"hizbQuarter":240,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","translation":"Who whispers [evil] into the breasts of mankind -","transliteration":"Al lazee yuwas wisu fee sudoorin naas"},{"number":6236,"numberInSurah":6,"juz":30,"page":604,"hizbQuarter":240,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","translation":"From among the jinn and mankind.\"","transliteration":"Minal jinnati wan naas"}]}