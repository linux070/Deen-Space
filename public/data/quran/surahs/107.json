{"number":107,"name":"سُورَةُ المَاعُونِ","englishName":"Al-Maa'un","englishNameTranslation":"Almsgiving","revelationType":"Meccan","numberOfAyahs":7,"ayahs":[{"number":6198,"numberInSurah":1,"juz":30,"page":602,"hizbQuarter":240,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translation":"Have you seen the one who denies the Recompense?","transliteration":"Ara-aital lazee yu kazzibu bid deen"},{"number":6199,"numberInSurah":2,"juz":30,"page":602,"hizbQuarter":240,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":"For that is the one who drives away the orphan","transliteration":"Fa zaalikal lazi yadu'ul-yateem"},{"number":6200,"numberInSurah":3,"juz":30,"page":602,"hizbQuarter":240,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":"And does not encourage the feeding of the poor.","transliteration":"Wa la ya huddu 'alaa ta'amil miskeen"},{"number":6201,"numberInSurah":4,"juz":30,"page":602,"hizbQuarter":240,"text":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","translation":"So woe to those who pray","transliteration":"Fa wai lul-lil mu salleen"},{"number":6202,"numberInSurah":5,"juz":30,"page":602,"hizbQuarter":240,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translation":"[But] who are heedless of their prayer -","transliteration":"Al lazeena hum 'an salaatihim sahoon"},{"number":6203,"numberInSurah":6,"juz":30,"page":602,"hizbQuarter":240,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translation":"Those who make show [of their deeds]","transliteration":"Al lazeena hum yuraa-oon"},{"number":6204,"numberInSurah":7,"juz":30,"page":602,"hizbQuarter":240,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","translation":"And withhold [simple] assistance.","transliteration":"Wa yamna'oonal ma'oon"}]}