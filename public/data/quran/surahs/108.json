{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"numberInSurah":1,"juz":30,"page":602,"hizbQuarter":240,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","translation":"Indeed, We have granted you, [O Muhammad], al-Kawthar.","transliteration":"Innaa a'taina kal kauthar"},{"number":6206,"numberInSurah":2,"juz":30,"page":602,"hizbQuarter":240,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","translation":"So pray to your Lord and sacrifice [to Him alone].","transliteration":"Fa salli li rabbika wanhar"},{"number":6207,"numberInSurah":3,"juz":30,"page":602,"hizbQuarter":240,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","translation":"Indeed, your enemy is the one cut off.","transliteration":"Inna shani-aka huwal abtar"}]}