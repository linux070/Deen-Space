{"number":80,"name":"سُورَةُ عَبَسَ","englishName":"Abasa","englishNameTranslation":"He frowned","revelationType":"Meccan","numberOfAyahs":42,"ayahs":[{"number":5759,"numberInSurah":1,"juz":30,"page":585,"hizbQuarter":234,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","translation":"The Prophet frowned and turned away","transliteration":"'Abasa wa tawallaa."},{"number":5760,"numberInSurah":2,"juz":30,"page":585,"hizbQuarter":234,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ","translation":"Because there came to him the blind man, [interrupting].","transliteration":"An jaa-ahul 'a-maa"},{"number":5761,"numberInSurah":3,"juz":30,"page":585,"hizbQuarter":234,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","translation":"But what would make you perceive, [O Muhammad], that perhaps he might be purified","transliteration":"Wa maa yudreeka la'allahu yaz zakkaa."},{"number":5762,"numberInSurah":4,"juz":30,"page":585,"hizbQuarter":234,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","translation":"Or be reminded and the remembrance would benefit him?","transliteration":"Au yaz zak karu fatanfa 'ahuz zikraa."},{"number":5763,"numberInSurah":5,"juz":30,"page":585,"hizbQuarter":234,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ","translation":"As for he who thinks himself without need,","transliteration":"Amma manis taghnaa"},{"number":5764,"numberInSurah":6,"juz":30,"page":585,"hizbQuarter":234,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","translation":"To him you give attention.","transliteration":"Fa-anta lahu tasaddaa"},{"number":5765,"numberInSurah":7,"juz":30,"page":585,"hizbQuarter":234,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","translation":"And not upon you [is any blame] if he will not be purified.","transliteration":"Wa ma 'alaika allaa yaz zakka."},{"number":5766,"numberInSurah":8,"juz":30,"page":585,"hizbQuarter":234,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","translation":"But as for he who came to you striving [for knowledge]","transliteration":"Wa amma man jaa-aka yas'a"},{"number":5767,"numberInSurah":9,"juz":30,"page":585,"hizbQuarter":234,"text":"وَهُوَ يَخْشَىٰ","translation":"While he fears [Allah],","transliteration":"Wahuwa yakhshaa,"},{"number":5768,"numberInSurah":10,"juz":30,"page":585,"hizbQuarter":234,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ","translation":"From him you are distracted.","transliteration":"Fa-anta 'anhu talah haa."},{"number":5769,"numberInSurah":11,"juz":30,"page":585,"hizbQuarter":234,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","translation":"No! Indeed, these verses are a reminder;","transliteration":"Kalla innaha tazkirah"},{"number":5770,"numberInSurah":12,"juz":30,"page":585,"hizbQuarter":234,"text":"فَمَن شَآءَ ذَكَرَهُۥ","translation":"So whoever wills may remember it.","transliteration":"Faman shaa a zakarah"},{"number":5771,"numberInSurah":13,"juz":30,"page":585,"hizbQuarter":234,"text":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","translation":"[It is recorded] in honored sheets,","transliteration":"Fi suhufim mukar rama,"},{"number":5772,"numberInSurah":14,"juz":30,"page":585,"hizbQuarter":234,"text":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","translation":"Exalted and purified,","transliteration":"Marfoo'atim mutah hara,"},{"number":5773,"numberInSurah":15,"juz":30,"page":585,"hizbQuarter":234,"text":"بِأَيْدِى سَفَرَةٍۢ","translation":"[Carried] by the hands of messenger-angels,","transliteration":"Bi'aidee safara"},{"number":5774,"numberInSurah":16,"juz":30,"page":585,"hizbQuarter":234,"text":"كِرَامٍۭ بَرَرَةٍۢ","translation":"Noble and dutiful.","transliteration":"Kiraamim bararah."},{"number":5775,"numberInSurah":17,"juz":30,"page":585,"hizbQuarter":234,"text":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","translation":"Cursed is man; how disbelieving is he.","transliteration":"Qutilal-insanu maa akfarah."},{"number":5776,"numberInSurah":18,"juz":30,"page":585,"hizbQuarter":234,"text":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","translation":"From what substance did He create him?","transliteration":"Min aiyyi shai-in Khalaq"},{"number":5777,"numberInSurah":19,"juz":30,"page":585,"hizbQuarter":234,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","translation":"From a sperm-drop He created him and destined for him;","transliteration":"Min nutfah; khalaqahu faqad-darah."},{"number":5778,"numberInSurah":20,"juz":30,"page":585,"hizbQuarter":234,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","translation":"Then He eased the way for him;","transliteration":"Thummas sabeela yas-sarah"},{"number":5779,"numberInSurah":21,"juz":30,"page":585,"hizbQuarter":234,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","translation":"Then He causes his death and provides a grave for him.","transliteration":"Thumma amatahu fa-aqbarah"},{"number":5780,"numberInSurah":22,"juz":30,"page":585,"hizbQuarter":234,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","translation":"Then when He wills, He will resurrect him.","transliteration":"Thumma iza shaa-a ansharah"},{"number":5781,"numberInSurah":23,"juz":30,"page":585,"hizbQuarter":234,"text":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","translation":"No! Man has not yet accomplished what He commanded him.","transliteration":"Kalla lamma yaqdi maa amarah."},{"number":5782,"numberInSurah":24,"juz":30,"page":585,"hizbQuarter":234,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","translation":"Then let mankind look at his food -","transliteration":"Falyanzuril insanu ilaa ta-amih"},{"number":5783,"numberInSurah":25,"juz":30,"page":585,"hizbQuarter":234,"text":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","translation":"How We poured down water in torrents,","transliteration":"Anna sabab nalmaa-a sabba."},{"number":5784,"numberInSurah":26,"juz":30,"page":585,"hizbQuarter":234,"text":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","translation":"Then We broke open the earth, splitting [it with sprouts],","transliteration":"Thumma sha qaqnal-arda shaqqa."},{"number":5785,"numberInSurah":27,"juz":30,"page":585,"hizbQuarter":234,"text":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","translation":"And caused to grow within it grain","transliteration":"Fa ambatna feeha habba"},{"number":5786,"numberInSurah":28,"juz":30,"page":585,"hizbQuarter":234,"text":"وَعِنَبًۭا وَقَضْبًۭا","translation":"And grapes and herbage","transliteration":"Wa 'inabaw-wa qadba"},{"number":5787,"numberInSurah":29,"juz":30,"page":585,"hizbQuarter":234,"text":"وَزَيْتُونًۭا وَنَخْلًۭا","translation":"And olive and palm trees","transliteration":"Wa zaitoonaw wanakh la'"},{"number":5788,"numberInSurah":30,"juz":30,"page":585,"hizbQuarter":234,"text":"وَحَدَآئِقَ غُلْبًۭا","translation":"And gardens of dense shrubbery","transliteration":"Wa hadaa-iqa ghulba"},{"number":5789,"numberInSurah":31,"juz":30,"page":585,"hizbQuarter":234,"text":"وَفَٰكِهَةًۭ وَأَبًّۭا","translation":"And fruit and grass -","transliteration":"Wa faki hataw-wa abba."},{"number":5790,"numberInSurah":32,"juz":30,"page":585,"hizbQuarter":234,"text":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","translation":"[As] enjoyment for you and your grazing livestock.","transliteration":"Mata'al-lakum wa li-an'amikum."},{"number":5791,"numberInSurah":33,"juz":30,"page":585,"hizbQuarter":234,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","translation":"But when there comes the Deafening Blast","transliteration":"Faiza jaa-atis saakhah."},{"number":5792,"numberInSurah":34,"juz":30,"page":585,"hizbQuarter":234,"text":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","translation":"On the Day a man will flee from his brother","transliteration":"Yauma yafir-rul mar-u min akheeh"},{"number":5793,"numberInSurah":35,"juz":30,"page":585,"hizbQuarter":234,"text":"وَأُمِّهِۦ وَأَبِيهِ","translation":"And his mother and his father","transliteration":"Wa ummihee wa abeeh"},{"number":5794,"numberInSurah":36,"juz":30,"page":585,"hizbQuarter":234,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","translation":"And his wife and his children,","transliteration":"Wa sahi batihee wa baneeh."},{"number":5795,"numberInSurah":37,"juz":30,"page":585,"hizbQuarter":234,"text":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","translation":"For every man, that Day, will be a matter adequate for him.","transliteration":"Likul limri-im-minuhm yaumaa-izin shaa nuy-yughneeh"},{"number":5796,"numberInSurah":38,"juz":30,"page":585,"hizbQuarter":234,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","translation":"[Some] faces, that Day, will be bright -","transliteration":"Wujoo huny-yauma-izim-musfira;"},{"number":5797,"numberInSurah":39,"juz":30,"page":585,"hizbQuarter":234,"text":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","translation":"Laughing, rejoicing at good news.","transliteration":"Dahi katum mustab shirah"},{"number":5798,"numberInSurah":40,"juz":30,"page":585,"hizbQuarter":234,"text":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","translation":"And [other] faces, that Day, will have upon them dust.","transliteration":"Wa wujoohuy yauma-izin 'alaiha ghabar a"},{"number":5799,"numberInSurah":41,"juz":30,"page":585,"hizbQuarter":234,"text":"تَرْهَقُهَا قَتَرَةٌ","translation":"Blackness will cover them.","transliteration":"Tarhaquha qatarah."},{"number":5800,"numberInSurah":42,"juz":30,"page":585,"hizbQuarter":234,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","translation":"Those are the disbelievers, the wicked ones.","transliteration":"Ulaa-ika humul-kafa ratul-fajarah."}]}