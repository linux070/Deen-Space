{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"numberInSurah":1,"juz":30,"page":591,"hizbQuarter":237,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","translation":"Exalt the name of your Lord, the Most High,","transliteration":"Sabbihisma Rabbikal A'laa"},{"number":5950,"numberInSurah":2,"juz":30,"page":591,"hizbQuarter":237,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","translation":"Who created and proportioned","transliteration":"Allazee khalaqa fasawwaa"},{"number":5951,"numberInSurah":3,"juz":30,"page":591,"hizbQuarter":237,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","translation":"And who destined and [then] guided","transliteration":"Wallazee qaddara fahadaa"},{"number":5952,"numberInSurah":4,"juz":30,"page":591,"hizbQuarter":237,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","translation":"And who brings out the pasture","transliteration":"Wallazeee akhrajal mar'aa"},{"number":5953,"numberInSurah":5,"juz":30,"page":591,"hizbQuarter":237,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","translation":"And [then] makes it black stubble.","transliteration":"Faja'alahoo ghusaaa'an ahwaa"},{"number":5954,"numberInSurah":6,"juz":30,"page":591,"hizbQuarter":237,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","translation":"We will make you recite, [O Muhammad], and you will not forget,","transliteration":"Sanuqri'uka falaa tansaaa"},{"number":5955,"numberInSurah":7,"juz":30,"page":591,"hizbQuarter":237,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","translation":"Except what Allah should will. Indeed, He knows what is declared and what is hidden.","transliteration":"Illaa maa shaaa'al laah; innahoo ya'lamul jahra wa maa yakhfaa"},{"number":5956,"numberInSurah":8,"juz":30,"page":591,"hizbQuarter":237,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","translation":"And We will ease you toward ease.","transliteration":"Wa nu-yassiruka lilyusraa"},{"number":5957,"numberInSurah":9,"juz":30,"page":591,"hizbQuarter":237,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","translation":"So remind, if the reminder should benefit;","transliteration":"Fazakkir in nafa'atizzikraa"},{"number":5958,"numberInSurah":10,"juz":30,"page":591,"hizbQuarter":237,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","translation":"He who fears [Allah] will be reminded.","transliteration":"Sa yazzakkaru maiyakhshaa"},{"number":5959,"numberInSurah":11,"juz":30,"page":591,"hizbQuarter":237,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","translation":"But the wretched one will avoid it -","transliteration":"Wa yatajannabuhal ashqaa"},{"number":5960,"numberInSurah":12,"juz":30,"page":591,"hizbQuarter":237,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","translation":"[He] who will [enter and] burn in the greatest Fire,","transliteration":"Allazee yaslan Naaral kubraa"},{"number":5961,"numberInSurah":13,"juz":30,"page":591,"hizbQuarter":237,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","translation":"Neither dying therein nor living.","transliteration":"Summa laa yamootu feehaa wa laa yahyaa"},{"number":5962,"numberInSurah":14,"juz":30,"page":591,"hizbQuarter":237,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","translation":"He has certainly succeeded who purifies himself","transliteration":"Qad aflaha man tazakkaa"},{"number":5963,"numberInSurah":15,"juz":30,"page":591,"hizbQuarter":237,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","translation":"And mentions the name of his Lord and prays.","transliteration":"Wa zakaras ma Rabbihee fasallaa"},{"number":5964,"numberInSurah":16,"juz":30,"page":592,"hizbQuarter":237,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translation":"But you prefer the worldly life,","transliteration":"Bal tu'siroonal hayaatad dunyaa"},{"number":5965,"numberInSurah":17,"juz":30,"page":592,"hizbQuarter":237,"text":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","translation":"While the Hereafter is better and more enduring.","transliteration":"Wal Aakhiratu khairunw wa abqaa"},{"number":5966,"numberInSurah":18,"juz":30,"page":592,"hizbQuarter":237,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","translation":"Indeed, this is in the former scriptures,","transliteration":"Inna haazaa lafis suhu fil oolaa"},{"number":5967,"numberInSurah":19,"juz":30,"page":592,"hizbQuarter":237,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","translation":"The scriptures of Abraham and Moses.","transliteration":"Suhufi Ibraaheema wa Moosaa"}]}